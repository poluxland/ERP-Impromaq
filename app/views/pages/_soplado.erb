
<div class="card-deck">
  <div class="card shadow">
    <div class="card-body">
      <h5 class="card-title"><i class="fas fa-poll text-success"></i> Producción horno</h5>

      <%= line_chart @soplado_horno, thousands: "." %>



    </div>
  </div>



  <div class="card shadow">
    <div class="card-body">
      <h5 class="card-title"><i class="fas fa-poll text-success"></i> CC54 Temp</h5>

      <%= line_chart @soplado_presion5, thousands: "." %>



    </div>
  </div>


  <div class="card shadow">
    <div class="card-body">
      <h5 class="card-title"><i class="fas fa-poll text-success"></i> Presiones</h5>

     <%= line_chart [
  {name: "Ducto P1 ascendente", data: @soplado_presion1},
  {name: "Ducto P2 ascendente", data: @soplado_presion2},
  {name: "CC54 P1", data: @soplado_presion3},
  {name: "CC54 P2", data: @soplado_presion4},
  {name: "Quench P1", data: @soplado_presion6}
] %>






    </div>
  </div>
</div>
